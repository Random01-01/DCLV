# PrivateStream Bridge — copie para .env e substitua todos os valores CHANGE_ME
# Nunca comite .env. Gere segredos com: openssl rand -hex 32

NODE_ENV=production
LOG_LEVEL=info

# Discord Developer Portal
DISCORD_TOKEN=CHANGE_ME_bot_token
DISCORD_CLIENT_ID=CHANGE_ME_application_id
DISCORD_GUILD_ID=CHANGE_ME_test_guild_id
# ID opcional de cargo(s) autorizados, separados por vírgula. Vazio = membros do servidor.
DISCORD_ALLOWED_ROLE_IDS=

# Comunicação privada Bot -> Backend; deve ser igual nos dois containers.
INTERNAL_API_SECRET=CHANGE_ME_long_random_secret
HMAC_SECRET=CHANGE_ME_another_long_random_secret

# URLs: PUBLIC_WEB_URL é o endereço que os membros abrem no navegador.
# Para capturar fora de localhost (inclusive LAN), use HTTPS com certificado confiável.
# Use proxy/túnel HTTPS para a porta 8080; HTTP/localhost é apenas para teste na mesma máquina.
PUBLIC_WEB_URL=http://localhost:8080
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
WEB_PORT=8080

# TURN/STUN. PUBLIC_TURN_HOST precisa ser alcançável pelos navegadores dos viewers.
# Para LAN, pode ser o IP privado do host; para internet, use DNS/IP público ou relay remoto.
TURN_HOST=localhost
PUBLIC_TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49152
TURN_MAX_PORT=49252
TURN_REALM=private-stream.local
# Opcional quando o host está atrás de NAT: IP público ou mapeamento public/private.
TURN_EXTERNAL_IP=
TURN_SECRET=CHANGE_ME_turn_static_auth_secret
TURN_TLS_CERT=/etc/coturn/certs/fullchain.pem
TURN_TLS_KEY=/etc/coturn/certs/privkey.pem

# O backend entrega apenas credenciais TURN temporárias (não estes segredos).
TURN_CREDENTIAL_TTL_SECONDS=600
ROOM_TTL_SECONDS=3600
ACCESS_TOKEN_TTL_SECONDS=600
MAX_VIEWERS=8
ICE_RELAY_ONLY=true

# Frontend/Vite
VITE_API_BASE_URL=

# cloudflared opcional. O profile tunnel usa quick tunnel se vazio;
# para um túnel nomeado, forneça o token e troque o command no compose.
CLOUDFLARE_TUNNEL_TOKEN=
